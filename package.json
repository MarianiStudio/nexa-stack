{
  "name": "nexa-stack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:next\" \"pnpm run dev:pb\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:next": "next dev",
    "dev:pb": "cd pb && ./pocketbase serve --http=127.0.0.1:8090",
    "pb:migrate": "cd pb && ./pocketbase migrate",
    "pb:admin": "cd pb && ./pocketbase superuser upsert $PB_ADMIN_EMAIL $PB_ADMIN_PASSWORD",
    "docs:sync": "node scripts/docs-sync/sync-all.mjs",
    "docs:sync:next": "node scripts/docs-sync/sync-next-docs.mjs",
    "docs:sync:tailwind": "node scripts/docs-sync/sync-tailwind-docs.mjs",
    "docs:sync:react": "node scripts/docs-sync/sync-react-docs.mjs",
    "docs:sync:shadcn": "node scripts/docs-sync/sync-shadcn-docs.mjs",
    "docs:sync:pocketbase": "node scripts/docs-sync/sync-pocketbase-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "pocketbase": "^0.27.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "isolated-vm": "^7.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "typescript": "^5"
  }
}
