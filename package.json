{
  "name": "nexa-stack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:next\" \"pnpm run dev:pb\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:next": "next dev",
    "dev:pb": "cd pb && ./pocketbase serve --http=127.0.0.1:8090",
    "pb:migrate": "cd pb && ./pocketbase migrate",
    "pb:admin": "cd pb && ./pocketbase superuser upsert $PB_ADMIN_EMAIL $PB_ADMIN_PASSWORD"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
